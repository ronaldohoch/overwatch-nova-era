{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "cd functions && tsc",
    "build:watch": "cd functions && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cd functions && tsc && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulator": "start npm run emulator:tsc && start npm run emulator:all",
    "emulator:tsc": "tsc --watch",
    "emulator:all": "firebase emulators:start --import ./emulator-data --export-on-exit ./emulator-data --inspect-functions"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "bcrypt": "^5.1.1",
    "express": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
